# ResistanceIQ — Test Environment Configuration Template
APP_ENV=test
DEBUG=false
PROJECT_NAME="ResistanceIQ Test Suite"

HOST=127.0.0.1
PORT=8000

DATABASE_URL=sqlite:///./test_resistanceiq.db
DB_ECHO=false

JWT_SECRET=test-environment-jwt-secret-key-32-characters-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

MODEL_REGISTRY_PATH=storage/models
STORAGE_LOCAL_PATH=storage/reports

ALLOW_DEV_SEEDING=true
ALLOW_DEV_FALLBACK_AUTH=true
RATE_LIMIT_PER_MINUTE=1000
