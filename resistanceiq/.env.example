# ResistanceIQ — Production Environment Configuration Template
# (Copy to .env and configure for your target environment. NEVER commit .env to version control.)

# Environment Mode: development | test | production
APP_ENV=production
DEBUG=false
PROJECT_NAME="ResistanceIQ Scientific Intelligence Platform"

# Network & Host
HOST=0.0.0.0
PORT=8000

# Database Connection (Use PostgreSQL in production)
DATABASE_URL=postgresql://resistanceiq_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/resistanceiq_prod
DB_ECHO=false

# Authentication & JWT Security (Generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_RANDOM_HEX_64_CHARACTERS_MINIMUM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated or list of trusted production domains)
BACKEND_CORS_ORIGINS=["https://app.resistanceiq.com","https://staging.resistanceiq.com"]

# Machine Learning Service & Model Storage
MODEL_REGISTRY_PATH=storage/models
STORAGE_LOCAL_PATH=storage/reports

# Security & Data Isolation
ALLOW_DEV_SEEDING=false
ALLOW_DEV_FALLBACK_AUTH=false
RATE_LIMIT_PER_MINUTE=120
