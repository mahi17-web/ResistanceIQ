# ==============================================================================
# ResistanceIQ — Production & Development Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit the active .env file or real secrets to version control.

# ─── Application Runtime Settings ─────────────────────────────────────────────
APP_NAME=ResistanceIQ
APP_ENV=production  # "development" | "test" | "staging" | "production"
DEBUG=false
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# ─── Database Configuration ───────────────────────────────────────────────────
# In Development: SQLite is supported
# DATABASE_URL=sqlite:///./resistanceiq_dev.db
# In Production: PostgreSQL is REQUIRED
DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/resistanceiq
DB_ECHO=false

# ─── Security, JWT & Cryptography ─────────────────────────────────────────────
# Minimum 32 cryptographically random characters in production
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS & Frontend Routing ──────────────────────────────────────────────────
FRONTEND_URL=https://app.resistanceiq.bio
CORS_ORIGINS=["https://app.resistanceiq.bio","http://localhost:5173"]

# ─── Transactional Email & SMTP Configuration ─────────────────────────────────
# In Production: EMAIL_PROVIDER=smtp (or transactional) with valid credentials.
# In Development/Test: EMAIL_PROVIDER=dev uses the local storage mailbox.
EMAIL_PROVIDER=smtp  # "smtp" | "transactional" | "dev"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=resistanceiq69@gmail.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM_EMAIL=resistanceiq69@gmail.com
SMTP_FROM_NAME=ResistanceIQ
SMTP_USE_TLS=true

# Optional Transactional Provider API Key (e.g. Resend, SendGrid, Mailgun)
EMAIL_API_KEY=
DEV_EMAIL_INBOX_DIR=./storage/dev_emails

# ─── ML Governance & Storage Services ─────────────────────────────────────────
MODEL_VERSION=v2.0.0-gbrt-ecfp4
MODEL_ARTIFACT_PATH=resistanceiq/storage/models/v2.0.0-gbrt-ecfp4.joblib
MODEL_ARTIFACT_SHA256=6fc915fa26716dc4a06bad71f586af95ee071acf11e9a5b8acdc5171fed55622
STORAGE_LOCAL_PATH=resistanceiq/storage/reports
STORAGE_URL=http://localhost:8000/storage
RATE_LIMIT_PER_MINUTE=120

# ─── Frontend Environment Variables (Vite) ────────────────────────────────────
# Set this when the frontend is hosted on a separate domain from the backend API.
# Leave empty or set to /api/v1 when served behind a reverse proxy.
VITE_API_BASE_URL=https://api.resistanceiq.bio
