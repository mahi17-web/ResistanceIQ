# ResistanceIQ — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# ─── Application Settings ────────────────────────────────────────────────────
APP_NAME=ResistanceIQ
APP_ENV=development  # development | test | staging | production
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ─── Database Configuration ──────────────────────────────────────────────────
# In development: SQLite is supported
DATABASE_URL=sqlite:///./resistanceiq_dev.db
# In production: PostgreSQL is REQUIRED (e.g. postgresql://user:password@localhost:5432/resistanceiq)
DB_ECHO=false

# ─── Security & Cryptography ─────────────────────────────────────────────────
# Minimum 32 characters in production
JWT_SECRET=super-secret-resistanceiq-jwt-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Transactional Email & SMTP Configuration ────────────────────────────────
# In production: A valid SMTP server or transactional provider is REQUIRED.
# In development/test: If SMTP is not provided, emails safely route to the dev mailbox.
EMAIL_PROVIDER=smtp  # smtp | transactional | dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=security@resistanceiq.bio
SMTP_FROM_NAME=ResistanceIQ Security
SMTP_USE_TLS=true

# Optional Transactional Provider Settings (SendGrid / Mailgun / AWS SES)
EMAIL_API_KEY=
DEV_EMAIL_INBOX_DIR=./storage/dev_emails

# ─── ML & Storage Services ───────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001
MODEL_REGISTRY_PATH=../storage/models
STORAGE_LOCAL_PATH=../storage/reports
STORAGE_URL=http://localhost:8000/storage
